# verse.openpak.org
OPENVERSE_ADDR=:20195
# The miiverse-api's HTTP address on the container network (the port that serves /cdn) and the web
# bridge key, the same value as PN_MIIVERSE_API_WEB_KEY on the API container.
OPENVERSE_API_URL=http://openpak-nn-juxtaposition-api:20090
PN_MIIVERSE_API_WEB_KEY=
OPENVERSE_PUBLIC_URL=https://verse.openpak.org
OPENVERSE_OPENPAK_URL=https://openpak.org
# Sign-in through openpak.org single sign-on (client "openverse"). CORE_URL is openpak.org's website
# as this container reaches it; the secret is SSO_CLIENT_OPENVERSE_SECRET from the website's .env;
# the session key signs the session cookies (32+ random characters).
OPENVERSE_CORE_URL=http://openpak-website:20010
SSO_CLIENT_OPENVERSE_SECRET=
OPENVERSE_SESSION_KEY=change-me-to-32-or-more-random-characters
#OPENVERSE_CONTACT_EMAIL=contact@openpak.org
# Fixture data and a sign-in without openpak.org, for screenshots and local work. Never in production.
#OPENVERSE_DEMO=1
# Device link codes (Linked devices) are in the Redis the Juxtaposition UI uses.
OPENVERSE_REDIS_ADDR=openpak-redis:6379
#OPENVERSE_REDIS_PASSWORD=
# The Juxtaposition UI, which still serves /admin (moderation).
OPENVERSE_LEGACY_URL=http://openpak-nn-juxtaposition-ui:20100
